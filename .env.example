# Copy to .env.local for development. Railway gets these as service variables.

# Signs session cookies. MUST be at least 32 chars and secret — anyone who
# knows it can forge a coach session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where mutable state lives (JSON store + uploaded media). Leave unset
# locally to use the repo root; set to the volume mount path in production.
# DATA_DIR=/data

# First-run bootstrap ONLY. If the store has no coach account yet, the first
# request to /login creates one from these and forces a password change on
# first sign-in. Ignored once a coach exists — changing these later will not
# change an existing password.
COACH_EMAIL=
COACH_PASSWORD=
